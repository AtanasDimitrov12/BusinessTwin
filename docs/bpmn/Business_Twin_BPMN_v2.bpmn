<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_BusinessTwin" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Business Twin project" exporterVersion="2.0">
  <bpmn:collaboration id="Collab_BusinessTwin">
    <bpmn:participant id="Pool_BT" name="Business Twin – testing a business decision (to-be, v2)" processRef="Process_BT" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BT" isExecutable="false">
    <bpmn:laneSet id="LaneSet_BT">
      <bpmn:lane id="Lane_Owner" name="Salon owner">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Gather</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Baseline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Base</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Browse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Hire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Mkt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Next</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Adjust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Adv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Decide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ReviewScenario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_More</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Business Twin (web app)">
        <bpmn:flowNodeRef>S_Calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Dash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Options</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Cases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Sim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Compare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_AddChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Adviser" name="Adviser (optional)">
        <bpmn:flowNodeRef>A_Review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Business decision to consider">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Gather" name="Gather current figures (bookings, sales, staff hours, costs, cash)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Baseline" name="Enter today's monthly baseline (add past months if available)">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Calc" name="Label inputs and calculate baseline: customers served, sales, costs, monthly result">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Dash" name="Show baseline dashboard and business map">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Check" name="Check baseline figures on the dashboard">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Base" name="Is the baseline correct?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Options" name="Show available changes: hire a worker, change price, more marketing">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Browse" name="Browse available changes and choose one to add">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Type" name="Which change to add?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Hire" name="Enter hire details: start month, hours, cost, expected customers and share that are new">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Price" name="Enter new price and expected change in demand">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Mkt" name="Enter campaign cost and expected new customers">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Cases" name="Build pessimistic, expected and optimistic cases">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Sim" name="Simulate coming months: capacity, sales, costs and cash; flag any cash shortfall">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Compare" name="Compare with baseline and explain key drivers">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Review" name="Review results and assumptions">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Next" name="What is the next step?">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Adjust" name="Adjust estimates for this scenario">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Save" name="Save plan">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Adv" name="Discuss with adviser?">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="A_Review" name="Review saved plan with owner">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Decide" name="Make the decision (outside the tool)">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End" name="Decision taken">
      <bpmn:incoming>F33</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S_AddChange" name="Add the change to the scenario and show the scenario summary">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_ReviewScenario" name="Review the changes in the scenario">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_More" name="Add another change?">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Gather" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Gather" targetRef="T_Baseline" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_Baseline" targetRef="S_Calc" />
    <bpmn:sequenceFlow id="F4" sourceRef="S_Calc" targetRef="S_Dash" />
    <bpmn:sequenceFlow id="F5" sourceRef="S_Dash" targetRef="T_Check" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Check" targetRef="G_Base" />
    <bpmn:sequenceFlow id="F7" name="Yes" sourceRef="G_Base" targetRef="S_Options" />
    <bpmn:sequenceFlow id="F8" sourceRef="S_Options" targetRef="T_Browse" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_Browse" targetRef="G_Type" />
    <bpmn:sequenceFlow id="F10" name="No, correct figures" sourceRef="G_Base" targetRef="T_Baseline" />
    <bpmn:sequenceFlow id="F11" name="Hire a worker" sourceRef="G_Type" targetRef="T_Hire" />
    <bpmn:sequenceFlow id="F12" name="Change price" sourceRef="G_Type" targetRef="T_Price" />
    <bpmn:sequenceFlow id="F13" name="More marketing" sourceRef="G_Type" targetRef="T_Mkt" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Hire" targetRef="S_AddChange" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_Price" targetRef="S_AddChange" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Mkt" targetRef="S_AddChange" />
    <bpmn:sequenceFlow id="F17" sourceRef="S_AddChange" targetRef="T_ReviewScenario" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_ReviewScenario" targetRef="G_More" />
    <bpmn:sequenceFlow id="F19" name="Yes" sourceRef="G_More" targetRef="T_Browse" />
    <bpmn:sequenceFlow id="F20" name="No, build scenario" sourceRef="G_More" targetRef="S_Cases" />
    <bpmn:sequenceFlow id="F21" sourceRef="S_Cases" targetRef="S_Sim" />
    <bpmn:sequenceFlow id="F22" sourceRef="S_Sim" targetRef="S_Compare" />
    <bpmn:sequenceFlow id="F23" sourceRef="S_Compare" targetRef="T_Review" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_Review" targetRef="G_Next" />
    <bpmn:sequenceFlow id="F25" name="Adjust estimates" sourceRef="G_Next" targetRef="T_Adjust" />
    <bpmn:sequenceFlow id="F26" name="Recalculate" sourceRef="T_Adjust" targetRef="S_Cases" />
    <bpmn:sequenceFlow id="F27" name="Test another scenario" sourceRef="G_Next" targetRef="S_Options" />
    <bpmn:sequenceFlow id="F28" name="Plan is ready" sourceRef="G_Next" targetRef="T_Save" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_Save" targetRef="G_Adv" />
    <bpmn:sequenceFlow id="F30" name="Yes" sourceRef="G_Adv" targetRef="A_Review" />
    <bpmn:sequenceFlow id="F31" name="No" sourceRef="G_Adv" targetRef="T_Decide" />
    <bpmn:sequenceFlow id="F32" sourceRef="A_Review" targetRef="T_Decide" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_Decide" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_BT">
    <bpmndi:BPMNPlane id="Plane_BT" bpmnElement="Collab_BusinessTwin">
      <bpmndi:BPMNShape id="Pool_BT_di" bpmnElement="Pool_BT" isHorizontal="true"><dc:Bounds x="40" y="40" width="3260" height="780" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Owner_di" bpmnElement="Lane_Owner" isHorizontal="true"><dc:Bounds x="70" y="40" width="3230" height="420" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="70" y="460" width="3230" height="220" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Adviser_di" bpmnElement="Lane_Adviser" isHorizontal="true"><dc:Bounds x="70" y="680" width="3230" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="122" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="90" y="274" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Gather_di" bpmnElement="T_Gather"><dc:Bounds x="180" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Baseline_di" bpmnElement="T_Baseline"><dc:Bounds x="330" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Calc_di" bpmnElement="S_Calc"><dc:Bounds x="480" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Dash_di" bpmnElement="S_Dash"><dc:Bounds x="630" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Check_di" bpmnElement="T_Check"><dc:Bounds x="630" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Base_di" bpmnElement="G_Base" isMarkerVisible="true"><dc:Bounds x="795" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="705" y="183" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Options_di" bpmnElement="S_Options"><dc:Bounds x="880" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Browse_di" bpmnElement="T_Browse"><dc:Bounds x="1030" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Type_di" bpmnElement="G_Type" isMarkerVisible="true"><dc:Bounds x="1195" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1105" y="183" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Hire_di" bpmnElement="T_Hire"><dc:Bounds x="1300" y="70" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Price_di" bpmnElement="T_Price"><dc:Bounds x="1300" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Mkt_di" bpmnElement="T_Mkt"><dc:Bounds x="1300" y="350" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Cases_di" bpmnElement="S_Cases"><dc:Bounds x="1880" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Sim_di" bpmnElement="S_Sim"><dc:Bounds x="2030" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Compare_di" bpmnElement="S_Compare"><dc:Bounds x="2180" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Review_di" bpmnElement="T_Review"><dc:Bounds x="2330" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Next_di" bpmnElement="G_Next" isMarkerVisible="true"><dc:Bounds x="2505" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2415" y="183" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Adjust_di" bpmnElement="T_Adjust"><dc:Bounds x="1880" y="70" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Save_di" bpmnElement="T_Save"><dc:Bounds x="2610" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Adv_di" bpmnElement="G_Adv" isMarkerVisible="true"><dc:Bounds x="2785" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="2695" y="183" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_Review_di" bpmnElement="A_Review"><dc:Bounds x="2890" y="710" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Decide_di" bpmnElement="T_Decide"><dc:Bounds x="3040" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="3212" y="232" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="3180" y="274" width="100" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_AddChange_di" bpmnElement="S_AddChange"><dc:Bounds x="1440" y="530" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_ReviewScenario_di" bpmnElement="T_ReviewScenario"><dc:Bounds x="1580" y="210" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_More_di" bpmnElement="G_More" isMarkerVisible="true"><dc:Bounds x="1765" y="225" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1675" y="183" width="110" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="158" y="250" /><di:waypoint x="180" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="300" y="250" /><di:waypoint x="330" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="450" y="250" /><di:waypoint x="540" y="250" /><di:waypoint x="540" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="600" y="570" /><di:waypoint x="630" y="570" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="690" y="530" /><di:waypoint x="690" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="750" y="250" /><di:waypoint x="795" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="845" y="250" /><di:waypoint x="940" y="250" /><di:waypoint x="940" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1000" y="570" /><di:waypoint x="1090" y="570" /><di:waypoint x="1090" y="290" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1150" y="250" /><di:waypoint x="1195" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="820" y="225" /><di:waypoint x="820" y="170" /><di:waypoint x="390" y="170" /><di:waypoint x="390" y="210" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1220" y="225" /><di:waypoint x="1220" y="110" /><di:waypoint x="1300" y="110" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1245" y="250" /><di:waypoint x="1300" y="250" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1220" y="275" /><di:waypoint x="1220" y="390" /><di:waypoint x="1300" y="390" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1420" y="110" /><di:waypoint x="1500" y="110" /><di:waypoint x="1500" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="1420" y="250" /><di:waypoint x="1500" y="250" /><di:waypoint x="1500" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="1420" y="390" /><di:waypoint x="1500" y="390" /><di:waypoint x="1500" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F17_di" bpmnElement="F17"><di:waypoint x="1560" y="570" /><di:waypoint x="1640" y="570" /><di:waypoint x="1640" y="290" /></bpmndi:BPMNEdge>
